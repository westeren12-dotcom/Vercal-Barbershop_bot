<%- include('partials/header') %>

<div class="page-header">
  <h1>💰 Revenue</h1>
  <p>Revenue tracking and history</p>
</div>

<div class="grid-2">
  <div class="chart-container">
    <h3>📆 Monthly Revenue</h3>
    <div class="bar-chart">
      <% 
        const maxMonthly = Math.max(...months.map(m => m.total), 1);
        months.forEach(function(m) { 
          const height = Math.max((m.total / maxMonthly) * 180, 4);
      %>
        <div class="bar-item">
          <div class="bar-value"><%= formatPrice(m.total) %></div>
          <div class="bar" style="height: <%= height %>px;"></div>
          <div class="bar-label"><%= m.month %></div>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<div class="table-container">
  <div class="table-header">
    <h2>Revenue Records</h2>
  </div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Service</th>
          <th>Barber</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        <% revenue.forEach(function(r) { %>
        <tr>
          <td><%= formatDate(r.date) %></td>
          <td><%= r.service.emoji %> <%= r.service.name %></td>
          <td><%= r.barber.name %></td>
          <td><strong style="color: var(--accent);"><%= formatPrice(r.amount) %></strong></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
