{
  "name": "vercal-barbershop-bot",
  "version": "1.0.0",
  "description": "Vercal Barbershop Telegram Bot — Revenue Tracking & Booking System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node src/seed.ts",
    "seed:reset": "ts-node src/seed.ts --reset",
    "dashboard": "ts-node src/dashboard/server.ts",
    "dashboard:build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "telegraf": "^4.16.3",
    "telegraf-session-local": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ejs": "^3.1.10",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "prisma": "^5.22.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}