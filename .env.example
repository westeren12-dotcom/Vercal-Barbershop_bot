# Environment Variables for Vercal Barbershop Bot
# Copy this file to .env and fill in the values

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vercal_barbershop?schema=public

# Admin Telegram User IDs (comma-separated)
# These users will have full admin access
# @Barber_abbosbek and @isakovvvv12
ADMIN_TELEGRAM_IDS=

# Clinic/Business Info
CLINIC_NAME=Vercal Barbershop
CLINIC_PHONE=
CLINIC_ADDRESS=
GOOGLE_MAPS_URL=

# JWT Secret (for dashboard session)
JWT_SECRET=change-this-to-a-strong-random-secret

# Dashboard Port
DASHBOARD_PORT=3000
